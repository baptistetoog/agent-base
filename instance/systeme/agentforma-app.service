[Unit]
Description=Espace agent (agentforma) - outil web de l'agent IA
After=network.target

[Service]
Type=simple
User=agentforma
Group=agentforma
WorkingDirectory=/home/agentforma
Environment="NOM_OUTIL=Espace agent"
Environment="NOM_AGENT=Mon agent"
Environment="PORT=4910"
EnvironmentFile=-/home/agentforma/.claude-token.env
ExecStart=/usr/bin/node /home/agentforma/app/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/agentforma

[Install]
WantedBy=multi-user.target
